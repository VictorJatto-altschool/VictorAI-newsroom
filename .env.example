# Copy this file to .env and fill in what you have. Every value is optional: a missing key switches that
# adapter to its mock. Keep comments on their own lines; never put a comment after a value.

APP_ENV=development
TZ_NAME=Africa/Lagos

# Leave empty for local SQLite at data/victor.db. Use a free Supabase or Neon Postgres URL in production.
DATABASE_URL=

# --- AI drafting (all free tiers). Preference order is drafting.provider_order in config/settings.yaml.
GEMINI_API_KEY=
GROQ_API_KEY=
# Any OpenAI-compatible endpoint. Pick one:
#   GitHub Models : AI_BASE_URL=https://models.github.ai/inference  AI_API_KEY=<GitHub PAT with models:read>  AI_MODEL=openai/gpt-4o-mini
#   OpenRouter    : AI_BASE_URL=https://openrouter.ai/api/v1          AI_API_KEY=<key>  AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Mistral       : AI_BASE_URL=https://api.mistral.ai/v1             AI_API_KEY=<key>  AI_MODEL=mistral-small-latest
#   Cerebras      : AI_BASE_URL=https://api.cerebras.ai/v1            AI_API_KEY=<key>  AI_MODEL=llama-3.3-70b
#   Ollama (local): AI_BASE_URL=http://localhost:11434/v1             AI_API_KEY=       AI_MODEL=llama3.1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Approval channel. Token from BotFather looks like 123456789:AAH... (digits, colon, letters). Chat id is your numeric user id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Publishing. X developer portal: app permissions Read and Write, then Keys and Tokens.
# API Key / API Key Secret = consumer keys. Access Token / Secret must be generated AFTER setting Read and Write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Media sources (optional; YouTube is read through free RSS, NASA's library needs no key)
YOUTUBE_API_KEY=
NASA_API_KEY=
