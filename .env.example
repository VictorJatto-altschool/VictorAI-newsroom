# Copy to .env and fill in what you have. Everything is optional; missing keys switch that adapter to its mock.
APP_ENV=development
DATABASE_URL=                     # leave empty for local SQLite at data/victor.db; Supabase/Neon URL for production
TZ_NAME=Africa/Lagos

# AI drafting (free tiers). Order of preference is drafting.provider_order in config/settings.yaml.
GEMINI_API_KEY=
GROQ_API_KEY=
# Any OpenAI-compatible endpoint. Examples (pick one, all have free tiers):
#   GitHub Models : AI_BASE_URL=https://models.github.ai/inference  AI_API_KEY=<GitHub PAT with models:read>  AI_MODEL=openai/gpt-4o-mini
#   OpenRouter    : AI_BASE_URL=https://openrouter.ai/api/v1          AI_API_KEY=<key>  AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Mistral       : AI_BASE_URL=https://api.mistral.ai/v1             AI_API_KEY=<key>  AI_MODEL=mistral-small-latest
#   Cerebras      : AI_BASE_URL=https://api.cerebras.ai/v1            AI_API_KEY=<key>  AI_MODEL=llama-3.3-70b
#   Ollama (local): AI_BASE_URL=http://localhost:11434/v1             AI_API_KEY=       AI_MODEL=llama3.1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Approval channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                 # your own Telegram user id; only this id may issue commands

# Publishing (X API, OAuth 1.0a user context for the single account)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Media sources
YOUTUBE_API_KEY=
NASA_API_KEY=
